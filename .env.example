# ---- Frontend (safe to expose; powerless without RLS) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- LOCAL DEMO MODE (offline UI review — simplest path, no backend at all) ----
# No Supabase, auth, email, or Cloudflare. Loads the Cedar Crossing sample
# property + 106 work items from local fixtures. Dev-only; excluded from prod.
# VITE_DEMO_MODE=true

# ---- DEV-ONLY auth bypass (local review before email auth is wired) ----
# Runs ONLY under `npm run dev`; hard-excluded from production builds.
# Requires a one-time dev password on the admin (see README → "Local dev auth bypass").
# Leave these OUT of any deployed environment.
# VITE_DEV_AUTH_BYPASS=true
# VITE_DEV_ADMIN_PASSWORD=choose-a-local-dev-password
# VITE_DEV_ADMIN_EMAIL=jessica@texascapitalpartners.com   # optional; defaults to the admin

# ---- Server-only (NEVER commit; used by scripts/*.mjs on your machine) ----
# Do not prefix with VITE_ or it will be bundled into the browser.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
